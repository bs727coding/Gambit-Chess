# Normalize line endings in the repo; check out with the platform default.
* text=auto

*.ps1 text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf

# Files read inside Linux containers keep LF everywhere.
Dockerfile text eol=lf
*.toml text eol=lf
*.sh text eol=lf

*.png binary
*.ico binary
*.wav binary
*.zst binary
