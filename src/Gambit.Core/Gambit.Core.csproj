<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rules of chess and the flow of a game. Platform-neutral so the online server can reuse it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gambit.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Openings\openings.tsv" LogicalName="Gambit.Core.Openings.openings.tsv" />
    <EmbeddedResource Include="Lessons\*.json" LogicalName="Gambit.Core.Lessons.%(Filename).json" />
    <EmbeddedResource Include="Puzzles\puzzles.csv" LogicalName="Gambit.Core.Puzzles.puzzles.csv" Condition="Exists('Puzzles\puzzles.csv')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gambit.Engine" />
    <InternalsVisibleTo Include="Gambit.Tests" />
  </ItemGroup>

</Project>
