<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.AnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gambit.App.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="20,8,20,20" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>

        <controls:EvalBar x:Name="Eval" VerticalAlignment="Center" />
        <controls:ChessBoardControl x:Name="Board" Grid.Column="1" MoveRequested="Board_MoveRequested" />

        <Grid Grid.Column="2" RowSpacing="12" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Engine -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Engine" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="EngineInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EngineSwitch" AutomationProperties.Name="Engine" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" IsOn="True" Toggled="EngineSwitch_Toggled" />
                    </Grid>
                    <StackPanel x:Name="Lines" Spacing="6" />
                </StackPanel>
            </Border>

            <!-- Position editor (replaces the move list while editing) -->
            <Border x:Name="EditorCard" Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="Set up a position" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Pick a piece, then click squares to place it (click again to remove). The eraser clears squares." Style="{StaticResource SecondaryTextStyle}" />
                    <VariableSizedWrapGrid x:Name="Palette" Orientation="Horizontal" ItemWidth="48" ItemHeight="48" MaximumRowsOrColumns="7" />
                    <ComboBox x:Name="EditSide" Header="Side to move" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="White to move" />
                        <ComboBoxItem Content="Black to move" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <CheckBox x:Name="CastleWK" Content="O-O" MinWidth="70" />
                        <CheckBox x:Name="CastleWQ" Content="O-O-O" MinWidth="80" />
                        <CheckBox x:Name="CastleBK" Content="…O-O" MinWidth="80" />
                        <CheckBox x:Name="CastleBQ" Content="…O-O-O" MinWidth="80" />
                    </StackPanel>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Start position" HorizontalAlignment="Stretch" Click="EditStart_Click" />
                        <Button Grid.Column="1" Content="Clear board" HorizontalAlignment="Stretch" Click="EditClear_Click" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Cancel" HorizontalAlignment="Stretch" Click="EditCancel_Click" />
                        <Button Grid.Column="1" Content="Done" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="EditDone_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Moves -->
            <Border x:Name="MovesCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="8,4,8,0">
                        <StackPanel Margin="0,0,120,0">
                            <TextBlock Text="Moves" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="OpeningText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                    </Grid>
                    <controls:MoveListView x:Name="MoveList" Grid.Row="1" PlySelected="MoveList_PlySelected" />

                    <!-- Variations: other moves tried from the current position, and side-line actions -->
                    <StackPanel x:Name="VariationPanel" Grid.Row="2" Spacing="6" Padding="8,0,8,4" Visibility="Collapsed">
                        <StackPanel x:Name="AlternativesRow" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Also tried here" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                <StackPanel x:Name="AlternativeButtons" Orientation="Horizontal" Spacing="4" />
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel x:Name="SideLineRow" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8AB;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SideLineText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Make main line" Click="PromoteLine_Click" Padding="8,2,8,3" FontSize="12" />
                            <Button Content="Delete line" Click="DeleteLine_Click" Padding="8,2,8,3" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation -->
            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" Click="First_Click" ToolTipService.ToolTip="Start (Home)" AutomationProperties.Name="Start">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="Prev_Click" ToolTipService.ToolTip="Back (←)" AutomationProperties.Name="Back">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                </Button>
                <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="Next_Click" ToolTipService.ToolTip="Forward (→)" AutomationProperties.Name="Forward">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" HorizontalAlignment="Stretch" Click="Last_Click" ToolTipService.ToolTip="End (End)" AutomationProperties.Name="End">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" HorizontalAlignment="Stretch" Click="Flip_Click" ToolTipService.ToolTip="Flip board (F)" AutomationProperties.Name="Flip board">
                    <FontIcon Glyph="&#xE7AD;" FontSize="14" />
                </Button>
                <Button Grid.Column="5" HorizontalAlignment="Stretch" Click="Reset_Click" ToolTipService.ToolTip="New analysis from the start position" AutomationProperties.Name="New analysis from the start position">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Import / export -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FenBox" PlaceholderText="Paste a FEN and press Load" FontSize="12" AutomationProperties.Name="FEN" />
                        <Button Grid.Column="1" Content="Load" Click="LoadFen_Click" AutomationProperties.Name="Load FEN" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="3" HorizontalAlignment="Stretch" Click="Edit_Click" AutomationProperties.Name="Edit position" ToolTipService.ToolTip="Set up a position">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Click="CopyFen_Click" AutomationProperties.Name="Copy FEN">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                <TextBlock Text="FEN" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="CopyPgn_Click" AutomationProperties.Name="Copy PGN">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                <TextBlock Text="PGN" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="PastePgn_Click" ToolTipService.ToolTip="Load a PGN or FEN from the clipboard" AutomationProperties.Name="Load a PGN or FEN from the clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77F;" FontSize="13" />
                                <TextBlock Text="Paste" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <InfoBar x:Name="Toast" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="520"
                 IsOpen="False" IsClosable="True" Margin="0,4,0,0" />
    </Grid>
</Page>
