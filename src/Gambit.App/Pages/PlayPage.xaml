<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Gambit.App.Pages">

    <Grid Padding="32,16,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Play" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Pick an opponent. Bots run entirely on your PC — from total beginner to full engine strength."
                       Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <InfoBar x:Name="ResumeBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational"
                 Title="Game in progress" Message="You have an unfinished game.">
            <InfoBar.ActionButton>
                <Button Content="Resume game" Click="Resume_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Bot roster -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="0,0,8,16">
                    <TextBlock Text="Computer opponents" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <GridView x:Name="BotGrid" SelectionMode="Single" IsItemClickEnabled="False"
                              SelectionChanged="BotGrid_SelectionChanged" Padding="0">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:BotCardModel">
                                <Grid Width="150" Height="172" Padding="8" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid HorizontalAlignment="Center" Margin="0,6,0,4">
                                        <Border Width="64" Height="64" CornerRadius="32" Background="{x:Bind AvatarBrush}">
                                            <TextBlock Text="{x:Bind Monogram}" FontSize="27" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,-4,-2" Background="#2E7D32" Visibility="{x:Bind BeatenVisibility}"
                                                ToolTipService.ToolTip="You've beaten this bot">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind RatingText}" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind RecordText}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock Text="Other ways to play" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" Click="HotSeat_Click" AutomationProperties.Name="Pass and play">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE716;" FontSize="24" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pass and play" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Two players on this PC" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" IsEnabled="False">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE774;" FontSize="24" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Play online" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Coming soon — matchmaking and friend challenges" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Selected bot + game options -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Padding="20" VerticalAlignment="Top" Margin="0,0,0,8">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="DetailAvatar" Width="72" Height="72" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="DetailRating" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DetailTagline" FontStyle="Italic" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailBio" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="DetailRecord" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="I play as" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="WhiteToggle" AutomationProperties.Name="Play as White" HorizontalAlignment="Stretch" Click="ColorToggle_Click" Tag="white">
                            <StackPanel Spacing="2">
                                <TextBlock Text="&#x2654;" FontFamily="Segoe UI Symbol" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="White" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="RandomToggle" AutomationProperties.Name="Random color" Grid.Column="1" HorizontalAlignment="Stretch" Click="ColorToggle_Click" Tag="random">
                            <StackPanel Spacing="2">
                                <FontIcon Glyph="&#xE8B1;" FontSize="20" Margin="0,3,0,3" />
                                <TextBlock Text="Random" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="BlackToggle" AutomationProperties.Name="Play as Black" Grid.Column="2" HorizontalAlignment="Stretch" Click="ColorToggle_Click" Tag="black">
                            <StackPanel Spacing="2">
                                <TextBlock Text="&#x265A;" FontFamily="Segoe UI Symbol" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Black" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <ComboBox x:Name="TimeControlBox" Header="Time control" HorizontalAlignment="Stretch" SelectionChanged="TimeControlBox_SelectionChanged" />

                    <ToggleSwitch x:Name="TakebacksSwitch" Header="Allow takebacks" OnContent="On" OffContent="Off" Toggled="TakebacksSwitch_Toggled" />

                    <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10" Click="Play_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                            <TextBlock x:Name="PlayButtonText" Text="Play" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
