<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,16,32,32" Spacing="8">
            <TextBlock x:Name="Greeting" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock x:Name="SubGreeting" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />

            <InfoBar x:Name="ContinueBar" IsOpen="False" IsClosable="False" Severity="Informational"
                     Title="Unfinished game" Message="Pick up where you left off.">
                <InfoBar.ActionButton>
                    <Button Content="Continue" Click="Continue_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Quick actions -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Top" Padding="18" Click="PlayCard_Click">
                    <StackPanel Spacing="10">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#2E7D32" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE768;" Foreground="White" FontSize="18" />
                        </Border>
                        <TextBlock Text="Play a bot" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                        <TextBlock x:Name="PlayCardText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Top" Padding="18" Click="Puzzles_Click">
                    <StackPanel Spacing="10">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#EF6C00" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xEA86;" Foreground="White" FontSize="18" />
                        </Border>
                        <TextBlock Text="Puzzles" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                        <TextBlock Text="Rated tactics, Puzzle Rush and a daily puzzle. Coming soon." Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Top" Padding="18" Click="Learn_Click">
                    <StackPanel Spacing="10">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#1565C0" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE7BE;" Foreground="White" FontSize="18" />
                        </Border>
                        <TextBlock Text="Lessons" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                        <TextBlock Text="Openings, tactics and endgames, step by step. Coming soon." Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Top" Padding="18" Click="Analysis_Click">
                    <StackPanel Spacing="10">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#6A1B9A" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE9D9;" Foreground="White" FontSize="18" />
                        </Border>
                        <TextBlock Text="Analysis board" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                        <TextBlock Text="Explore any position with the engine. Paste FEN or PGN." Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Stats -->
            <TextBlock Text="Your progress" Style="{StaticResource SectionHeaderStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Games played" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatGames" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Wins · Losses · Draws" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatRecord" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Strongest bot beaten" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatBestBot" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Best win streak" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatStreak" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent games -->
            <TextBlock Text="Recent games" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel x:Name="RecentList" Spacing="6" />
        </StackPanel>
    </ScrollViewer>
</Page>
