<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- A small tile: an accent icon, a title and one line -->
        <Style x:Key="ShortcutStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,16,32,32" Spacing="12">
            <StackPanel>
                <TextBlock x:Name="Greeting" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SubGreeting" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Success" Title="Update available">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateBarButton" Content="Update and restart" Click="Update_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Your next game and today's puzzle, each on a board -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="NextGameBoardHost" Width="168" Height="168" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="NextGameLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid x:Name="NextGameAvatar" Width="36" Height="36" VerticalAlignment="Center" />
                                <TextBlock x:Name="NextGameTitle" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </StackPanel>
                            <TextBlock x:Name="NextGameDetail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button x:Name="NextGameButton" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Click="NextGame_Click" />
                                <Button x:Name="ChooseButton" Content="More bots" Click="Choose_Click" AutomationProperties.Name="Choose another bot" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="DailyBoardHost" Width="168" Height="168" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Daily puzzle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DailyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="NoWrap" />
                            <TextBlock x:Name="DailyDetail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Button x:Name="DailyButton" Padding="16,6" Margin="0,4,0,0" Click="Daily_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Shortcuts -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ShortcutStyle}" Click="Puzzles_Click" AutomationProperties.Name="Puzzles">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA86;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Puzzles" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PuzzleCardText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ShortcutStyle}" Click="Learn_Click" AutomationProperties.Name="Lessons">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BE;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Lessons" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="LessonsCardText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ShortcutStyle}" Click="Analysis_Click" AutomationProperties.Name="Analysis board">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Analysis board" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Explore a position or a game" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- Progress -->
            <TextBlock Text="Your progress" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Games played" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatGames" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Wins · Losses · Draws" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatRecord" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Strongest bot beaten" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatBestBot" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Best win streak" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StatStreak" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recent games -->
            <TextBlock Text="Recent games" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,0" />
            <StackPanel x:Name="RecentList" Spacing="6" />
        </StackPanel>
    </ScrollViewer>
</Page>
