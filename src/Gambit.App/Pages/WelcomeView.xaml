<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gambit.App.Pages.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Compact enough that "Get started" shows without scrolling at the default window size. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" Padding="32,20,32,24" Spacing="6" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Image x:Name="Logo" Width="44" Height="44" VerticalAlignment="Center" />
                <TextBlock Text="Welcome to Gambit" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Two quick questions, so the app can start you at the right level."
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />

            <TextBlock Text="What should we call you?" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,2" />
            <TextBox x:Name="NameBox" MaxLength="24" HorizontalAlignment="Left" Width="320"
                     AutomationProperties.Name="Your name" />

            <TextBlock Text="How much chess have you played?" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,2" />
            <StackPanel x:Name="LevelList" Spacing="2" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" MinHeight="40" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button x:Name="StartButton" Content="Get started" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                <Button x:Name="SkipButton" Content="Skip" Click="Skip_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
