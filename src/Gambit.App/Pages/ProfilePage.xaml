<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gambit.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,16,32,32" Spacing="8">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="AvatarHost" Width="80" Height="80" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" />
                        <Button x:Name="RenameButton" Click="Rename_Click" ToolTipService.ToolTip="Change display name" AutomationProperties.Name="Change display name" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE70F;" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="SinceText" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Statistics" Style="{StaticResource SectionHeaderStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Games" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="GamesText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Win rate" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="WinRateText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Wins · Losses · Draws" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="RecordText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Win streak (best)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StreakText" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Record against bots" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <StackPanel x:Name="BotRecords" Spacing="2" />
            </Border>

            <TextBlock Text="Game history" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel x:Name="History" Spacing="6" />

            <TextBlock Text="Puzzles" Style="{StaticResource SectionHeaderStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Text="Puzzle rating" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PuzzleRatingText" Style="{StaticResource TitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="PuzzleStatsText" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="RushStatsText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="8">
                    <controls:RatingChart x:Name="PuzzleChart" Height="150" />
                </Border>
            </Grid>

            <TextBlock Text="Openings you play" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <StackPanel x:Name="OpeningsList" Spacing="2" />
            </Border>

            <Grid>
                <TextBlock Text="Achievements" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Name="AchievementSummary" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource SecondaryTextStyle}" />
            </Grid>
            <VariableSizedWrapGrid x:Name="AchievementGrid" Orientation="Horizontal" ItemWidth="260" ItemHeight="76" />
        </StackPanel>
    </ScrollViewer>
</Page>
