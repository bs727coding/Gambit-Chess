<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.PuzzleSolvePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gambit.App.Controls">

    <Grid Padding="20,8,20,20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <controls:ChessBoardControl x:Name="Board" MoveRequested="Board_MoveRequested" />

        <StackPanel Grid.Column="1" Spacing="12">
            <!-- Mode header -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="ModeTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ModeSubtitle" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="RushPanel" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="RushTimer" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock x:Name="RushScore" FontWeight="SemiBold" />
                            <TextBlock x:Name="RushStrikes" Foreground="#E5484D" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusBadge" Width="44" Height="44" CornerRadius="22" Background="#5C6BC0" VerticalAlignment="Top">
                        <FontIcon x:Name="StatusIcon" Glyph="&#xE768;" Foreground="White" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rating + puzzle info -->
            <Border x:Name="RatingCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Your puzzle rating" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="RatingText" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock x:Name="RatingDelta" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="Puzzle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="PuzzleRating" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ThemesText" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HintButton" HorizontalAlignment="Stretch" Click="Hint_Click" AutomationProperties.Name="Hint">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE82F;" FontSize="14" />
                        <TextBlock Text="Hint" />
                    </StackPanel>
                </Button>
                <Button x:Name="SolutionButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="Solution_Click" AutomationProperties.Name="Show solution">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                        <TextBlock Text="Solution" />
                    </StackPanel>
                </Button>
                <Button x:Name="RetryButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="Retry_Click" AutomationProperties.Name="Retry">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Retry" />
                    </StackPanel>
                </Button>
            </Grid>
            <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10" Click="Next_Click" AutomationProperties.Name="Next puzzle">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="NextText" Text="Next puzzle" FontSize="15" FontWeight="SemiBold" />
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </StackPanel>
            </Button>
            <HyperlinkButton x:Name="AnalysisLink" Content="Open this position in the analysis board" Click="Analysis_Click" />
        </StackPanel>
    </Grid>
</Page>
