<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.LearnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,16,32,32" Spacing="8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Learn" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <Button x:Name="ContinueButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="16,8" Click="Continue_Click" AutomationProperties.Name="Continue learning">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="ContinueText" Text="Continue learning" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border x:Name="ReviewCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ReviewBadge" Width="48" Height="48" CornerRadius="24" Background="#6A1B9A">
                        <FontIcon Glyph="&#xE81C;" FontSize="20" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Opening review" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReviewText" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ReviewButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                            Padding="16,8" Click="Review_Click" AutomationProperties.Name="Review openings">
                        <TextBlock x:Name="ReviewButtonText" Text="Review" />
                    </Button>
                </Grid>
            </Border>
            <StackPanel x:Name="CourseList" Spacing="16" Margin="0,12,0,0" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,8,0,0"
                     Title="Tip"
                     Message="Lessons award up to three stars — finish without mistakes for a perfect score. Use Hint whenever you are stuck." />
        </StackPanel>
    </ScrollViewer>
</Page>
