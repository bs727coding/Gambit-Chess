<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gambit.App.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="20,8,20,20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SideColumn" Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Board with a player bar above and below. Bar widths follow the board size. -->
        <Grid x:Name="BoardColumn" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PlayerBar x:Name="TopBar" HorizontalAlignment="Center" />
            <controls:ChessBoardControl x:Name="Board" Grid.Row="1" MoveRequested="Board_MoveRequested" />
            <controls:PlayerBar x:Name="BottomBar" Grid.Row="2" HorizontalAlignment="Center" />
        </Grid>

        <!-- Side panel -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Opponent card with chat bubble -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="OpponentAvatar" Width="56" Height="56" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="OpponentName" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="OpponentTagline" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ChatBubble" CornerRadius="8" Padding="12,8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                        <TextBlock x:Name="ChatText" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Moves -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="8,4,8,0">
                        <TextBlock Text="Moves" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <controls:MoveListView x:Name="MoveList" Grid.Row="1" PlySelected="MoveList_PlySelected" />
                </Grid>
            </Border>

            <!-- History navigation -->
            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="FirstButton" HorizontalAlignment="Stretch" Click="First_Click" ToolTipService.ToolTip="First move (Home)" AutomationProperties.Name="First move">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button x:Name="PrevButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="Prev_Click" ToolTipService.ToolTip="Previous move (←)" AutomationProperties.Name="Previous move">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                </Button>
                <Button x:Name="NextButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="Next_Click" ToolTipService.ToolTip="Next move (→)" AutomationProperties.Name="Next move">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                </Button>
                <Button x:Name="LastButton" Grid.Column="3" HorizontalAlignment="Stretch" Click="Last_Click" ToolTipService.ToolTip="Latest position (End)" AutomationProperties.Name="Latest position">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" HorizontalAlignment="Stretch" Click="Flip_Click" ToolTipService.ToolTip="Flip board (F)" AutomationProperties.Name="Flip board">
                    <FontIcon Glyph="&#xE7AD;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Game actions -->
            <Grid Grid.Row="3" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TakebackButton" HorizontalAlignment="Stretch" Click="Takeback_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        <TextBlock Text="Takeback" />
                    </StackPanel>
                </Button>
                <Button x:Name="DrawButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="Draw_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="½" FontWeight="SemiBold" />
                        <TextBlock Text="Draw" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResignButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="Resign_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                        <TextBlock Text="Resign" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Post-game -->
            <Grid Grid.Row="4" x:Name="PostGamePanel" ColumnSpacing="6" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Rematch_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Rematch" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="NewGame_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New game" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <InfoBar x:Name="Toast" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="520"
                 IsOpen="False" IsClosable="True" Margin="0,0,0,8" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1250" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="380" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
