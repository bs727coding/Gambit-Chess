<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gambit.App.Controls">

    <Grid Padding="20,8,20,20" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <controls:EvalBar x:Name="Eval" VerticalAlignment="Center" />
        <controls:ChessBoardControl x:Name="Board" Grid.Column="1" />

        <Grid Grid.Column="2" RowSpacing="10" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accuracy summary -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Game review" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="OpeningText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="ProgressPanel" Spacing="6">
                        <TextBlock x:Name="ProgressText" Text="Analysing the game…" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ProgressBar x:Name="Progress" Maximum="1" />
                    </StackPanel>
                    <Grid x:Name="SummaryGrid" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="WhiteName" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <Border CornerRadius="6" Padding="10,4" Background="#F0F0F0" HorizontalAlignment="Left">
                                <TextBlock x:Name="WhiteAccuracy" FontSize="22" FontWeight="SemiBold" Foreground="#202020" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="BlackName" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <Border CornerRadius="6" Padding="10,4" Background="#303030" HorizontalAlignment="Left">
                                <TextBlock x:Name="BlackAccuracy" FontSize="22" FontWeight="SemiBold" Foreground="#F0F0F0" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CountsGrid" ColumnSpacing="8" RowSpacing="2" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Verdict on the current move -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="VerdictBadge" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Background="#808080">
                        <TextBlock x:Name="VerdictSymbol" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="VerdictTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="VerdictDetail" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:EvalGraph x:Name="Graph" Grid.Row="2" Height="84" PlySelected="Graph_PlySelected" />

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8">
                <controls:MoveListView x:Name="MoveList" PlySelected="MoveList_PlySelected" />
            </Border>

            <Grid Grid.Row="4" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" Click="First_Click" ToolTipService.ToolTip="Start (Home)" AutomationProperties.Name="Start">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="Prev_Click" ToolTipService.ToolTip="Previous move (←)" AutomationProperties.Name="Previous move">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                </Button>
                <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="Next_Click" ToolTipService.ToolTip="Next move (→)" AutomationProperties.Name="Next move">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" HorizontalAlignment="Stretch" Click="Last_Click" ToolTipService.ToolTip="End (End)" AutomationProperties.Name="End">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" HorizontalAlignment="Stretch" Click="NextKey_Click" ToolTipService.ToolTip="Jump to the next mistake, miss or great move" AutomationProperties.Name="Next key moment">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7C1;" FontSize="13" />
                        <TextBlock Text="Key" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" HorizontalAlignment="Stretch" Click="Flip_Click" ToolTipService.ToolTip="Flip board" AutomationProperties.Name="Flip board">
                    <FontIcon Glyph="&#xE7AD;" FontSize="14" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
