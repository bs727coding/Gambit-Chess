<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,16,32,32" Spacing="12">
            <StackPanel>
                <TextBlock Text="Play online" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Rated games against people on a Gambit server, or a private game with a friend using a code." Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <!-- Connection and account -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerBox" Header="Server address" PlaceholderText="http://localhost:5080" />
                        <Button x:Name="ConnectButton" Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                                Click="Connect_Click" Content="Connect" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8A8A8A" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatsText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Sign in or create an account (when the server needs one) -->
                    <StackPanel x:Name="AccountPanel" Spacing="10" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock x:Name="AccountTitle" Text="Sign in" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        <TextBlock x:Name="AccountHint" Style="{StaticResource SecondaryTextStyle}" />
                        <InfoBar x:Name="InsecureBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="Not encrypted"
                                 Message="This address starts with http://, so your password would cross the internet unencrypted. Prefer a server with an https:// address, or connect through Tailscale." />
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="UsernameBox" Header="Username" MaxLength="20" AutomationProperties.Name="Username" />
                            <PasswordBox x:Name="PasswordInput" Grid.Column="1" Header="Password" MaxLength="128" AutomationProperties.Name="Password"
                                         KeyDown="AccountField_KeyDown" />
                            <TextBox x:Name="InviteBox" Grid.Row="1" Header="Invite code" PlaceholderText="ABCD-EFGH" MaxLength="9"
                                     CharacterCasing="Upper" AutomationProperties.Name="Invite code" KeyDown="AccountField_KeyDown" />
                            <PasswordBox x:Name="ConfirmInput" Grid.Row="1" Grid.Column="1" Header="Password again" MaxLength="128"
                                         AutomationProperties.Name="Password again" KeyDown="AccountField_KeyDown" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AccountButton" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Content="Sign in" Click="Account_Click" />
                            <HyperlinkButton x:Name="SwitchModeButton" Content="New here? Create an account" Click="SwitchMode_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Signed in and connected -->
                    <StackPanel x:Name="SignedInPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button Click="Invite_Click" AutomationProperties.Name="Invite a friend">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                                <TextBlock Text="Invite a friend" />
                            </StackPanel>
                        </Button>
                        <Button Content="Sign out" Click="SignOut_Click" />
                        <Button x:Name="ServerBackupButton" Click="ServerBackup_Click" Visibility="Collapsed" AutomationProperties.Name="Back up the server">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="Back up server…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border x:Name="InvitePanel" Visibility="Collapsed" CornerRadius="6" Padding="12" HorizontalAlignment="Left"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Invite code" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="InviteCodeText" FontSize="24" FontWeight="SemiBold" IsTextSelectionEnabled="True" CharacterSpacing="100" />
                                <TextBlock x:Name="InviteNote" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="CopyInvite_Click" AutomationProperties.Name="Copy invite code">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid x:Name="LobbyGrid" ColumnSpacing="12" IsHitTestVisible="False" Opacity="0.45">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quick pairing -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Quick pairing" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                        <TextBlock Text="Get matched with the next player looking for the same time control." Style="{StaticResource SecondaryTextStyle}" />
                        <VariableSizedWrapGrid x:Name="SeekGrid" Orientation="Horizontal" ItemWidth="104" ItemHeight="58" />
                        <StackPanel x:Name="SeekingPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="20" Height="20" />
                            <TextBlock x:Name="SeekingText" VerticalAlignment="Center" />
                            <Button Content="Cancel" Click="CancelSeek_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Friends -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Play a friend" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                        <TextBlock Text="Create a game and send your friend the code, or enter a code you received." Style="{StaticResource SecondaryTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ChallengeTime" Header="Time" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="ChallengeColor" Grid.Column="1" Header="I play" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Random" />
                                <ComboBoxItem Content="White" />
                                <ComboBoxItem Content="Black" />
                            </ComboBox>
                            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Create" Click="CreateChallenge_Click" />
                        </Grid>
                        <Border x:Name="CodePanel" Visibility="Collapsed" CornerRadius="6" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Your game code" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="CodeText" FontSize="28" FontWeight="SemiBold" IsTextSelectionEnabled="True" CharacterSpacing="200" />
                                    <TextBlock Text="Waiting for your friend to join…" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Click="CopyCode_Click" AutomationProperties.Name="Copy code">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        <TextBlock Text="Copy" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="JoinBox" Header="Join with a code" PlaceholderText="e.g. 3F9A2C" MaxLength="6" CharacterCasing="Upper" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Join" Click="Join_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live games -->
            <Border x:Name="WatchCard" Style="{StaticResource CardStyle}" Padding="20" IsHitTestVisible="False" Opacity="0.45">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Watch live games" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                            <TextBlock Text="Follow a game in progress, move by move." Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Click="RefreshGames_Click" AutomationProperties.Name="Refresh live games">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="LiveGamesList" Spacing="8" />
                    <TextBlock x:Name="NoGamesText" Text="No games in progress right now." Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
            <InfoBar x:Name="NoticeBar" IsOpen="False" Severity="Informational" IsClosable="True" Title="From the server" />
            <InfoBar x:Name="DoneBar" IsOpen="False" Severity="Success" IsClosable="True" />

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Hosting a server"
                     Message="Run the Gambit server on any PC (./build.ps1 server). The first time, it shows an invite code for your own account, which becomes the server's admin; then use Invite a friend to let others join. To play over the internet, deploy the server (see docs/ONLINE.md)." />
        </StackPanel>
    </ScrollViewer>
</Page>
