<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gambit.App.Pages.PuzzlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,16,32,32" Spacing="8">
            <TextBlock Text="Puzzles" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Sharpen your tactics with thousands of rated puzzles." Style="{StaticResource SecondaryTextStyle}" />

            <Border Style="{StaticResource CardStyle}" Padding="28" Margin="0,16,0,0">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="48" Background="#EF6C00" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xEA86;" FontSize="42" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="Coming in the next update" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   Text="The puzzle trainer is scheduled for Session 3 of the roadmap. Here is what it will include:" />
                        <StackPanel Spacing="6" Margin="0,6,0,0">
                            <TextBlock Text="•  Rated puzzles that adapt to you (Glicko-2 puzzle rating)" TextWrapping="Wrap" />
                            <TextBlock Text="•  Puzzle Rush — 3 minute, 5 minute and Survival modes" TextWrapping="Wrap" />
                            <TextBlock Text="•  A daily puzzle and streaks" TextWrapping="Wrap" />
                            <TextBlock Text="•  Practice by theme: forks, pins, mates, endgames and more" TextWrapping="Wrap" />
                            <TextBlock Text="•  Ranks to climb, with per-theme statistics" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"
                                   Text="Puzzles come from the open Lichess puzzle database (public domain, CC0)." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
