<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.org only. Note: on this network one of api.nuget.org's CDN edge IPs is sometimes unreachable
    (TCP connect times out after 21 s). build.ps1 retries restore, and packages already downloaded are
    cached, so retries make progress. If v3 keeps failing, swap the source for the v2 endpoint:
      <add key="nuget.org-v2" value="https://www.nuget.org/api/v2/" />
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
